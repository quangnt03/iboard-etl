<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title|default("VN30 Volatility Report") }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        font-family: "Space Grotesk", sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <div class="relative overflow-hidden">
      <div class="absolute -top-32 -left-24 h-96 w-96 rounded-full bg-indigo-500/20 blur-3xl"></div>
      <div class="absolute top-40 -right-24 h-96 w-96 rounded-full bg-emerald-500/15 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-cyan-500/10 blur-3xl"></div>
    </div>

    <main class="relative mx-auto max-w-6xl px-6 py-16">
      <header class="flex flex-col gap-6">
        <div class="flex items-center gap-3 text-sm uppercase tracking-[0.3em] text-slate-400">
          <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
          VN30 Analytics
        </div>
        <div class="flex flex-col gap-3">
          <h1 class="text-4xl font-semibold text-white md:text-5xl">
            {{ title|default("Intraday Volatility Snapshot") }}
          </h1>
          <p class="max-w-2xl text-base text-slate-300">
            {{ subtitle|default("Top 10 most volatile VN30 stocks with volume context.") }}
          </p>
        </div>
        <div class="flex flex-wrap gap-4 text-sm text-slate-400">
          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2">
            Generated: {{ generated_at|default("N/A") }}
          </div>
          <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2">
            Source: {{ source|default("SSI iBoard API") }}
          </div>
        </div>
      </header>

      {% set rows = rows|default(data, true)|default([]) %}

      <section class="mt-10 rounded-3xl border border-white/10 bg-slate-900/60 p-6 shadow-2xl shadow-slate-900/50">
        <div class="flex flex-col gap-1 border-b border-white/10 pb-4">
          <h2 class="text-xl font-semibold text-white">Top Volatility Leaders</h2>
          <p class="text-sm text-slate-400">Sorted by volatility descending.</p>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border border-white/10">
          <table class="w-full border-collapse text-sm">
            <thead class="bg-white/5 text-left text-xs uppercase tracking-widest text-slate-400">
              <tr>
                <th class="px-4 py-3">Ticker</th>
                <th class="px-4 py-3 text-right">Open</th>
                <th class="px-4 py-3 text-right">High</th>
                <th class="px-4 py-3 text-right">Low</th>
                <th class="px-4 py-3 text-right">Volatility %</th>
                <th class="px-4 py-3 text-right">Today Volume</th>
                <th class="px-4 py-3 text-right">5-Day Avg Volume</th>
                <th class="px-4 py-3 text-right">Volume Ratio</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              {% for row in rows[:10] %}
              {% set open_value = row.open|default(row.open_price, true) %}
              {% set high_value = row.high|default(row.high_price, true) %}
              {% set low_value = row.low|default(row.low_price, true) %}
              {% set volatility_value = row.volatility_pct|default(row.intraday_volatility, true) %}
              {% if volatility_value is not none %}
                {% if volatility_value <= 1 %}
                  {% set volatility_display = volatility_value * 100 %}
                {% else %}
                  {% set volatility_display = volatility_value %}
                {% endif %}
              {% else %}
                {% set volatility_display = none %}
              {% endif %}
              {% set today_volume = row.today_volume|default(row.day_volume, true) %}
              <tr class="bg-transparent transition hover:bg-white/5">
                <td class="px-4 py-3 font-semibold text-white">{{ row.ticker|default("—") }}</td>
                <td class="px-4 py-3 text-right text-slate-200">
                  {{ "%.2f"|format(open_value) if open_value is not none else "—" }}
                </td>
                <td class="px-4 py-3 text-right text-slate-200">
                  {{ "%.2f"|format(high_value) if high_value is not none else "—" }}
                </td>
                <td class="px-4 py-3 text-right text-slate-200">
                  {{ "%.2f"|format(low_value) if low_value is not none else "—" }}
                </td>
                <td class="px-4 py-3 text-right text-emerald-300">
                  {{ "%.2f"|format(volatility_display) if volatility_display is not none else "—" }}%
                </td>
                <td class="px-4 py-3 text-right text-slate-200">
                  {{ "{:,.0f}".format(today_volume) if today_volume is not none else "—" }}
                </td>
                <td class="px-4 py-3 text-right text-slate-200">
                  {{ "{:,.0f}".format(row.avg_5d_volume) if row.avg_5d_volume is not none else "—" }}
                </td>
                <td class="px-4 py-3 text-right text-cyan-200">
                  {{ "%.2f"|format(row.volume_ratio) if row.volume_ratio is not none else "—" }}
                </td>
              </tr>
              {% else %}
              <tr>
                <td colspan="8" class="px-4 py-6 text-center text-slate-400">
                  No data available for the latest trading day.
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </body>
</html>
